Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"

  config.vm.define "szapata-S" do |control|
    control.vm.hostname = "szapata-S"
    control.vm.network "private_network", ip: "192.168.56.110"
    
    control.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      v.customize ["modifyvm", :id, "--name", "szapata-S"]
    end
    
    control.vm.provision "shell", path: "scripts/server.sh"
  end
  
  
  config.vm.define "szapata-SW" do |worker|
    worker.vm.hostname = "szapata-SW"
    worker.vm.network "private_network", ip: "192.168.56.111"
    
    worker.vm.provider "virtualbox" do |v|
      v.customize ["modifyvm", :id, "--name", "szapata-SW"]
      v.memory = 512
      v.cpus = 1
    end
    
    worker.vm.provision "shell", path: "scripts/agent.sh"
  end
end
